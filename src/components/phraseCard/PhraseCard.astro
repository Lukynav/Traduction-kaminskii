---
const { languaje } = Astro.props
const ENGLISH_PHRASE =
  'Being a translator means performing the noble job of communicating men who are separated by linguistic barriers that are totally or partially insurmountable for them.'
const SPANISH_PHRASE =
  'Ser traductor significa ejercer el noble oficio de comunicar entre sí a hombres separados por barreras lingüísticas, total o parcialmente, infranqueables para ellos.'
const AUTHOR = 'Valentín García Yebra'
---

<section
  class="border-y-2 border-sky-300 shadow-sm bg-sky-50 flex justify-center items-center mt-2 flex-col px-4 text-lg"
>
  {
    languaje ? (
      <>
        <p class="py-1">Spanish ⇔ English</p>
        <p class="w-full flex justify-center py-1">English ⇔ Spanish</p>
      </>
    ) : (
      <>
        <p class="py-1">Español ⇔ Inglés</p>
        <p class="w-full flex justify-center py-1">Inglés ⇔ Español</p>
      </>
    )
  }
</section>

<section class="max-w-3xl m-autoh-24 p-2 m-auto mt-8">
    <article
      class="w-full rounded-xl px-7 md:px-10 py-5 sm:px-12 sm:py-12 bg-[url('/images/bg.png')] bg-cover"
    >
      <strong class="text-black font-semibold drop-shadow-sm shadow-white md:text-xl"
        >{languaje === 'english' ? ENGLISH_PHRASE : SPANISH_PHRASE}</strong
      >
      <p class="text-slate-900 font-medium text-sm mt-4 sm:mt-12 md:text-lg">{AUTHOR}</p>
    </article>
  </div>
</section>
